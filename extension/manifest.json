{
  "manifest_version": 3,
  "name": "Bookmark OS",
  "short_name": "Bookmark OS",
  "version": "1.2.0",
  "description": "Your bookmarks as a macOS-style desktop on every new tab. No account, no permissions — everything stays in your browser.",
  "homepage_url": "https://github.com/chengmarc/chengmarc.github.io",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
