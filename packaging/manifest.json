{
  "manifest_version": 3,
  "name": "Home Page OS",
  "short_name": "Home Page OS",
  "version": "2.0.0",
  "description": "The only home page you need. Your bookmarks, synced from your browser, laid out as a desktop on every new tab. No account needed.",
  "homepage_url": "https://github.com/chengmarc/chengmarc.github.io",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_permissions": [
    "bookmarks"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
