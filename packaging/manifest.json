{
  "manifest_version": 3,
  "name": "Bookmark OS",
  "short_name": "Bookmark OS",
  "version": "1.4.0",
  "description": "Turn your browser's bookmarks into a macOS-style desktop on every new tab, kept in sync automatically. No account needed.",
  "homepage_url": "https://github.com/chengmarc/chengmarc.github.io",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_permissions": [
    "bookmarks"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
